[Unit]
Description=Refresh HalteWecker VBB release
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/haltewecker/pipeline/HalterWeckerAPIService
Environment=REPO=/srv/haltewecker/pipeline/HalterWeckerAPIService
Environment=DATA_ROOT=/srv/haltewecker/data
ExecStart=/usr/bin/python3 /srv/haltewecker/pipeline/HalterWeckerAPIService/scripts/refresh_vbb_release.py --refresh
