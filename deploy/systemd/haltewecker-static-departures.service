[Unit]
Description=Build HalteWecker static departures SQLite database
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/haltewecker/pipeline/HalterWeckerAPIService
EnvironmentFile=/etc/haltewecker-stop-data.env
Environment=REPO=/srv/haltewecker/pipeline/HalterWeckerAPIService
Environment=DATA_ROOT=/srv/haltewecker/data
ExecStart=/usr/bin/flock -n /run/lock/haltewecker-stop-data.lock /srv/haltewecker/pipeline/HalterWeckerAPIService/scripts/run_static_departures_pipeline.sh
